{
  "manifest_version": 3,
  "name": "Asistencia Google Meet",
  "version": "1.1.0",
  "description": "Registra entradas, salidas y tiempo conectado en Google Meet.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Cuenta de asistencia",
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://meet.google.com/*",
    "http://localhost:3000/*",
    "https://*.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": [
        "src/config.js",
        "src/api.js",
        "src/meet-observer.js",
        "src/content.js"
      ],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ]
}
