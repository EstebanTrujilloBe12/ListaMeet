PORT=3000
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=asistencia_meet
MYSQL_USER=root
MYSQL_PASSWORD=change_me
# Activa TLS si tu proveedor MySQL lo exige. Mantenlo en true salvo que el
# proveedor indique expresamente lo contrario.
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Se crea una sola vez al iniciar el servidor. No incluyas estos valores en Git.
ADMIN_NAME=Administrador
ADMIN_EMAIL=tu-correo@ejemplo.com
ADMIN_PASSWORD=elige-una-contrasena-larga-y-privada
# Separar los orígenes con comas. El primero es el panel; el segundo permite
# peticiones del content script de Meet. Añade además chrome-extension://<ID>
# si tu navegador envía ese origen para la extensión.
CORS_ORIGIN=http://localhost:3000,https://meet.google.com,chrome-extension://YOUR_EXTENSION_ID
